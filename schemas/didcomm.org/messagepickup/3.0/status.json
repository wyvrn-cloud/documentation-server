{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messagepickup/3.0/status",
  "description": "Mediator reports the state of the recipient's message queue. Only sent while the recipient is connected.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/messagepickup/3.0/status"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "message_count"
      ],
      "properties": {
        "recipient_did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^#]+$"
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "longest_waited_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "newest_received_time": {
          "type": "integer",
          "minimum": 0
        },
        "oldest_received_time": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "live_delivery": {
          "type": "boolean"
        }
      }
    }
  }
}
