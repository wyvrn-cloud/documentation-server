{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "coordinate-mediation/3.0/recipient-update-response",
  "description": "Mediator confirms the result of each requested recipient update.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/coordinate-mediation/3.0/recipient-update-response"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "updated"
      ],
      "properties": {
        "updated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "recipient_did",
              "action",
              "result"
            ],
            "properties": {
              "recipient_did": {
                "type": "string",
                "pattern": "^did:[a-z0-9]+:[^#]+$"
              },
              "action": {
                "enum": [
                  "add",
                  "remove"
                ]
              },
              "result": {
                "enum": [
                  "client_error",
                  "server_error",
                  "no_change",
                  "success"
                ]
              }
            }
          }
        }
      }
    }
  }
}
