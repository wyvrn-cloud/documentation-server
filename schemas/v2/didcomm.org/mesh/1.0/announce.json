{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mesh/1.0/announce",
  "description": "Periodically advertises presence and direct neighbors, signed over routing_id || signing_key || neighbors || timestamp. On constrained transports (BLE, LoRa) the binary encoding replaces this JSON form.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/mesh/1.0/announce"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "routing_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "An 8-byte routing ID (SHA-256(signing_key)[0..8]), base64url."
        },
        "signing_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "The 32-byte Ed25519 public key, base64url."
        },
        "direct_neighbors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$",
            "description": "An 8-byte routing ID (SHA-256(signing_key)[0..8]), base64url."
          }
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0,
          "description": "Milliseconds since the epoch."
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "A 64-byte Ed25519 signature, base64url."
        }
      },
      "required": [
        "routing_id",
        "signing_key",
        "direct_neighbors",
        "timestamp",
        "signature"
      ]
    }
  }
}
