{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payments/1.0/subscription-status",
  "description": "Mandates profile: synchronizes a mandate's status.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/payments/1.0/subscription-status"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "active",
            "past_due",
            "canceled",
            "paused"
          ]
        },
        "next_due_at": {
          "type": "string"
        },
        "last_paid_at": {
          "type": "string"
        },
        "past_due": {
          "type": "boolean"
        },
        "outstanding_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "mandate_id": {
          "type": "string"
        },
        "cycle_id": {
          "type": "string"
        },
        "quote_id": {
          "type": "string"
        },
        "ext": {
          "type": "object",
          "description": "Namespaced extensions (reverse-DNS keys); unknown keys MUST be ignored."
        }
      },
      "required": [
        "mandate_id",
        "status"
      ]
    }
  }
}
