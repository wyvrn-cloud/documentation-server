{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payments/1.0/methods",
  "description": "The payee lists its supported methods, assets and defaults.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/payments/1.0/methods"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "e.g. method:evm, method:bank:iban."
              },
              "variants": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "variant": {
                "type": "object"
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaults": {
          "type": "object",
          "properties": {
            "preferred": {
              "type": "string"
            },
            "variant": {
              "type": "object"
            }
          }
        },
        "reusable_supported": {
          "type": "boolean"
        },
        "subscriptions_supported": {
          "type": "boolean"
        },
        "mandate_id": {
          "type": "string"
        },
        "cycle_id": {
          "type": "string"
        },
        "quote_id": {
          "type": "string"
        },
        "ext": {
          "type": "object",
          "description": "Namespaced extensions (reverse-DNS keys); unknown keys MUST be ignored."
        }
      },
      "required": [
        "supported"
      ]
    }
  }
}
