{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "payments/1.0/compliance-request",
  "description": "Asks for compliance evidence (verifiable presentations, IVMS101) before a handshake can be accepted.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/payments/1.0/compliance-request"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "vc_presentation_definition": {
          "type": "object"
        },
        "ivms101_required": {
          "type": "boolean"
        },
        "mandate_id": {
          "type": "string"
        },
        "cycle_id": {
          "type": "string"
        },
        "quote_id": {
          "type": "string"
        },
        "ext": {
          "type": "object",
          "description": "Namespaced extensions (reverse-DNS keys); unknown keys MUST be ignored."
        }
      }
    }
  }
}
