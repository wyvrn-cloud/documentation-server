{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "present-proof/3.0/ack",
  "description": "Acknowledges a message (adopted ack). thid is the thread being acknowledged. The verifier accepts the presentation, when it said it would (will_confirm).",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/present-proof/3.0/ack"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "OK",
            "PENDING"
          ]
        }
      }
    }
  }
}
