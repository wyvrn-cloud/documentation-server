{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "messagepickup/3.0/delivery-request",
  "description": "Recipient asks for up to limit queued messages. The mediator replies with delivery, or status if the queue is empty.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/messagepickup/3.0/delivery-request"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "return_route": {
      "enum": [
        "none",
        "all",
        "thread"
      ],
      "description": "return_route extension; set to all to receive the reply on the same connection."
    },
    "body": {
      "type": "object",
      "required": [
        "limit"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "recipient_did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^#]+$"
        }
      }
    }
  }
}
