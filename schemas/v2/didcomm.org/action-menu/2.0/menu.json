{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "action-menu/2.0/menu",
  "description": "The responder's menu of actions. The requester shows one active menu per connection.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/action-menu/2.0/menu"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Shown at the top of the menu."
        },
        "description": {
          "type": "string"
        },
        "errormsg": {
          "type": "string",
          "description": "Says the last perform didn't work as expected."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "title"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Sent back in perform when chosen."
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "disabled": {
                "type": "boolean",
                "description": "Unavailable until some requirement is met."
              },
              "form": {
                "type": "object",
                "description": "A quick form: its params are collected and sent in perform.",
                "properties": {
                  "description": {
                    "type": "string"
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "title"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "default": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean",
                          "default": true
                        },
                        "type": {
                          "type": "string",
                          "default": "text",
                          "description": "Only text is defined."
                        }
                      }
                    }
                  },
                  "submit-label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "options"
      ]
    }
  }
}
