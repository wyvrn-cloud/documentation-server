{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questionanswer/1.0/question",
  "description": "Asks the responder a question with a fixed set of valid answers.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/questionanswer/1.0/question"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "question_text": {
          "type": "string"
        },
        "question_detail": {
          "type": "string",
          "description": "Optional fine print about the question and its answers."
        },
        "nonce": {
          "type": "string",
          "description": "Signed with the answer when signature_required."
        },
        "signature_required": {
          "type": "boolean"
        },
        "valid_responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              }
            }
          }
        },
        "expires_time": {
          "type": "integer",
          "minimum": 0,
          "description": "UTC epoch seconds."
        }
      },
      "required": [
        "question_text",
        "valid_responses"
      ]
    }
  }
}
