{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "poe/1.0/propose-poe",
  "description": "The prover negotiates the program or parameters (optional).",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/poe/1.0/propose-poe"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "program": {
          "type": "object",
          "required": [
            "program_id"
          ],
          "properties": {
            "program_id": {
              "type": "string"
            },
            "public_constraints": {
              "type": "object"
            }
          }
        },
        "disclosure": {
          "type": "string",
          "description": "What is disclosed beyond the ZK proof, e.g. proof-only."
        }
      },
      "required": [
        "program"
      ]
    }
  }
}
