{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "receipts/1.0/message-receipts",
  "description": "Receipts for messages: each message's id, its new state and when it changed.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/receipts/1.0/message-receipts"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "receipts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "message_id",
              "state",
              "timestamp"
            ],
            "properties": {
              "message_id": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "received",
                  "viewed",
                  "deleted"
                ]
              },
              "timestamp": {
                "type": "integer",
                "minimum": 0,
                "description": "UTC epoch seconds."
              }
            }
          }
        }
      },
      "required": [
        "receipts"
      ]
    }
  }
}
