{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger/1.0/settle",
  "description": "Proposes settling the balance as of an entry; each planned transfer runs as a Payments 1.0 exchange.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/ledger/1.0/settle"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "ledger_id": {
          "type": "string",
          "description": "The ledger's id."
        },
        "balance_snapshot": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^-?[0-9]+$",
            "description": "Atomic units."
          },
          "description": "Net balance per participant DID."
        },
        "settlement_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "quantity": {
                "type": "string",
                "pattern": "^-?[0-9]+$",
                "description": "Atomic units."
              },
              "display": {
                "type": "object"
              }
            }
          }
        },
        "partial": {
          "type": "boolean"
        },
        "as_of_seq": {
          "type": "integer",
          "minimum": 0
        },
        "as_of_hash": {
          "type": "string"
        }
      },
      "required": [
        "ledger_id",
        "balance_snapshot",
        "settlement_plan",
        "partial",
        "as_of_seq",
        "as_of_hash"
      ]
    }
  }
}
