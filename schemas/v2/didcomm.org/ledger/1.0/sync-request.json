{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger/1.0/sync-request",
  "description": "Asks for the entries after last_seq, to catch up.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/ledger/1.0/sync-request"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "ledger_id": {
          "type": "string",
          "description": "The ledger's id."
        },
        "last_seq": {
          "type": "integer",
          "minimum": 0
        },
        "last_hash": {
          "type": "string"
        }
      },
      "required": [
        "ledger_id",
        "last_seq",
        "last_hash"
      ]
    }
  }
}
