{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "signing/1.0/ack",
  "description": "Acknowledges receipt (e.g. of provide-artifacts), optionally as a JWS receipt for non-repudiation. Threads with thid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/signing/1.0/ack"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "received": {
          "type": "string",
          "description": "The message name acknowledged."
        },
        "session_id": {
          "type": "string",
          "description": "The signing session's id."
        },
        "receipt_jti": {
          "type": "string"
        }
      },
      "required": [
        "received",
        "session_id"
      ]
    }
  }
}
