{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "signing/1.0/combine",
  "description": "The coordinator announces aggregation status, threshold satisfaction or on-chain execution. Threads with thid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/signing/1.0/combine"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "description": "The signing session's id."
        },
        "status": {
          "type": "string",
          "description": "e.g. threshold_met, executed."
        },
        "aggregation_result": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none",
                "math",
                "contract"
              ]
            },
            "artifact_link": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "txid": {
              "type": "string"
            },
            "chain_id": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "session_id",
        "status"
      ]
    }
  }
}
