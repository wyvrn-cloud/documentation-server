{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "message-pickup/4.0/status",
  "description": "Status of the queue. message_count is the only required field; recipient_did echoes the request's. Never queued: only sent on an active connection.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/message-pickup/4.0/status"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "recipient_did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^#]+$",
          "description": "Only for this recipient DID."
        },
        "message_count": {
          "type": "integer",
          "minimum": 0
        },
        "newest_received_time": {
          "type": "integer",
          "minimum": 0,
          "description": "UTC epoch milliseconds."
        },
        "oldest_received_time": {
          "type": "integer",
          "minimum": 0,
          "description": "UTC epoch milliseconds."
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "live_delivery": {
          "type": "boolean"
        }
      },
      "required": [
        "message_count"
      ]
    }
  }
}
