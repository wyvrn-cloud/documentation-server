{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaults/1.0/propose",
  "description": "Proposes a shared encrypted data vault. purpose SHOULD be workflow:<template_id>#<instance_id> for a Workflow 1.0 instance. Answered with offer. Threaded under the workflow with pthid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/vaults/1.0/propose"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string"
        },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "object",
          "properties": {
            "retention": {
              "enum": [
                "ephemeral",
                "durable"
              ]
            },
            "ttl_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "limits": {
              "type": "object",
              "properties": {
                "max_docs": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "max_doc_bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "backend_prefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index_schema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "purpose",
        "participants"
      ]
    }
  }
}
