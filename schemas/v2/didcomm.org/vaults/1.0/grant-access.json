{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaults/1.0/grant-access",
  "description": "The controller delegates a ZCAP-LD capability (read, write, query or replicate, with caveats) to a participant. Threaded under the workflow with pthid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/vaults/1.0/grant-access"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "description": "The participant's DID."
        },
        "capability": {
          "type": "object"
        }
      },
      "required": [
        "to",
        "capability"
      ]
    }
  }
}
