{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaults/1.0/notify",
  "description": "Announces a change: a document created or updated, the vault sealed or replicated. Threaded under the workflow with pthid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/vaults/1.0/notify"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "doc-created",
            "doc-updated",
            "sealed",
            "replicated"
          ]
        },
        "doc_id": {
          "type": "string"
        },
        "indexed": {
          "type": "object"
        }
      },
      "required": [
        "kind"
      ]
    }
  }
}
