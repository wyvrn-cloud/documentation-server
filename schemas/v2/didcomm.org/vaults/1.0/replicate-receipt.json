{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaults/1.0/replicate-receipt",
  "description": "The digests and target document ids a replication produced. Threaded under the workflow with pthid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/vaults/1.0/replicate-receipt"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "replicated": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "digest": {
                "type": "string"
              },
              "doc_id": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
