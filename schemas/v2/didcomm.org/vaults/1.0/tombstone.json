{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vaults/1.0/tombstone",
  "description": "Retires the vault: deletes documents, or (on immutable backends) destroys the keys. Threaded under the workflow with pthid.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/vaults/1.0/tombstone"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "strategy": {
          "enum": [
            "delete",
            "destroy-keys"
          ]
        },
        "evidence_doc_id": {
          "type": "string"
        }
      },
      "required": [
        "strategy"
      ]
    }
  }
}
