{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webrtc/1.0/offer",
  "description": "The caller's SDP offer, with a signed DTLS fingerprint proof. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/webrtc/1.0/offer"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "sdp": {
          "type": "string"
        },
        "fingerprint_proof": {
          "type": "object",
          "description": "The DTLS certificate fingerprints, signed with the sender's DID key so the media channel is bound to the DIDComm identity.",
          "required": [
            "fingerprints",
            "kid",
            "jws"
          ],
          "properties": {
            "fingerprints": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "dtls_role": {
              "enum": [
                "actpass",
                "active",
                "passive"
              ]
            },
            "alg": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "created": {
              "type": "integer"
            },
            "expires": {
              "type": "integer"
            },
            "jws": {
              "type": "string"
            }
          }
        },
        "trickle": {
          "type": "boolean"
        },
        "policy": {
          "type": "string"
        },
        "ice_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "urls"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              }
            }
          }
        },
        "tie_breaker": {
          "type": "integer",
          "description": "Resolves glare when both sides offer."
        }
      },
      "required": [
        "sdp",
        "fingerprint_proof"
      ]
    }
  }
}
