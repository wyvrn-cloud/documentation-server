{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webrtc/1.0/create-room",
  "description": "The host asks the SFU mediator to create a room. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/webrtc/1.0/create-room"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "description": "The SFU room's id."
        },
        "max_participants": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "object",
          "properties": {
            "simulcast": {
              "type": "boolean"
            },
            "e2ee": {
              "type": "boolean"
            },
            "recording": {
              "type": "boolean"
            }
          }
        },
        "policy": {
          "type": "object",
          "properties": {
            "ice_policy": {
              "type": "string"
            },
            "codec_preferences": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "room_id"
      ]
    }
  }
}
