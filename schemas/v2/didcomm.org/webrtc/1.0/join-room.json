{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webrtc/1.0/join-room",
  "description": "A participant joins a room with its media and capabilities. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/webrtc/1.0/join-room"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "description": "The SFU room's id."
        },
        "media": {
          "type": "array",
          "items": {
            "enum": [
              "audio",
              "video",
              "screen"
            ]
          }
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "simulcast": {
              "type": "boolean"
            },
            "max_recv_bitrate": {
              "type": "integer"
            },
            "codecs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "room_id"
      ]
    },
    "oob_thid": {
      "type": "string",
      "description": "Required on the first message after an out-of-band invite link: the invitation's thid."
    }
  }
}
