{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "webrtc/1.0/room-created",
  "description": "The SFU's endpoint, ICE servers and end-to-end encryption config for the new room. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/webrtc/1.0/room-created"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "room_id": {
          "type": "string",
          "description": "The SFU room's id."
        },
        "sfu_endpoint": {
          "type": "string"
        },
        "ice_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "urls"
            ],
            "properties": {
              "urls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "username": {
                "type": "string"
              },
              "credential": {
                "type": "string"
              }
            }
          }
        },
        "e2ee_config": {
          "type": "object",
          "properties": {
            "suite": {
              "type": "string"
            },
            "key_distribution": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "room_id",
        "sfu_endpoint"
      ]
    }
  }
}
