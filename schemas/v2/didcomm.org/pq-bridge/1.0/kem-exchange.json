{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pq-bridge/1.0/kem-exchange",
  "description": "Carries a KEM encapsulation key and/or a ciphertext against the peer's key (hybrid suites: classical too), signed in signing modes. Sizes are checked before decapsulation (ML-KEM-768 key 1184 bytes, ciphertext 1088; X25519 32). MUST be authcrypted; thid identifies the PQ session.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/pq-bridge/1.0/kem-exchange"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "suite": {
          "type": "string"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Key generation; 0 for the first exchange."
        },
        "ephemeral_did": {
          "type": "string",
          "pattern": "^did:",
          "description": "A fresh ephemeral DID for this PQ session (never reused)."
        },
        "kid": {
          "type": "string"
        },
        "kid_thumbprint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "base64url"
        },
        "public_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "classical_public_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "ciphertext": {
          "type": [
            "string",
            "null"
          ]
        },
        "classical_ciphertext": {
          "type": [
            "string",
            "null"
          ]
        },
        "peer_kid": {
          "type": [
            "string",
            "null"
          ],
          "description": "The peer key encapsulated against; required with ciphertext."
        },
        "signature": {
          "type": "object",
          "required": [
            "alg",
            "kid",
            "value"
          ],
          "properties": {
            "alg": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "transcript_hash": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "base64url"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "required": [
        "suite",
        "generation",
        "ephemeral_did",
        "kid",
        "transcript_hash"
      ]
    }
  }
}
