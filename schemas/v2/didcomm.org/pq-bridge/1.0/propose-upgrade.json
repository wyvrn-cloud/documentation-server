{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pq-bridge/1.0/propose-upgrade",
  "description": "Proposes upgrading the connection to post-quantum protection: suites and modes in order of preference, and the initiator's ephemeral DID. MUST be authcrypted; thid identifies the PQ session.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/pq-bridge/1.0/propose-upgrade"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "base64url"
        },
        "ephemeral_did": {
          "type": "string",
          "pattern": "^did:",
          "description": "A fresh ephemeral DID for this PQ session (never reused)."
        },
        "ephemeral_did_document": {
          "type": "object"
        },
        "binding": {
          "type": "object",
          "required": [
            "alg",
            "kid",
            "value"
          ],
          "properties": {
            "alg": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "description": "Optional detached signature over the ephemeral DID document by the long-lived key."
        },
        "rotation_overlap_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "max_envelope_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "suites",
        "modes",
        "nonce",
        "ephemeral_did"
      ]
    }
  }
}
