{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pq-bridge/1.0/decline-upgrade",
  "description": "Declines, saying what is supported. MUST be authcrypted; thid identifies the PQ session.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/pq-bridge/1.0/decline-upgrade"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "no_supported_suite, no_supported_mode, policy_rejected, rate_limited, or free text."
        },
        "supported_suites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supported_modes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "reason"
      ]
    }
  }
}
