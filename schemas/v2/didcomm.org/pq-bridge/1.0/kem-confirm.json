{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pq-bridge/1.0/kem-confirm",
  "description": "Confirms the shared secret with an HKDF-derived MAC binding the transcript and both ephemeral DIDs; verified before any application data. MUST be authcrypted; thid identifies the PQ session.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/pq-bridge/1.0/kem-confirm"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Key generation; 0 for the first exchange."
        },
        "ephemeral_did": {
          "type": "string",
          "pattern": "^did:",
          "description": "A fresh ephemeral DID for this PQ session (never reused)."
        },
        "confirm_mac": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "base64url"
        }
      },
      "required": [
        "generation",
        "ephemeral_did",
        "confirm_mac"
      ]
    }
  }
}
