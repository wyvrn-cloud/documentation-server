{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pq-bridge/1.0/rotate-key",
  "description": "Starts re-keying to a new generation with a new ephemeral DID; the old keys stay usable for overlap_seconds. MUST be authcrypted; thid identifies the PQ session.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/pq-bridge/1.0/rotate-key"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "current_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Key generation; 0 for the first exchange."
        },
        "current_ephemeral_did": {
          "type": "string",
          "pattern": "^did:",
          "description": "A fresh ephemeral DID for this PQ session (never reused)."
        },
        "new_generation": {
          "type": "integer",
          "minimum": 0,
          "description": "Key generation; 0 for the first exchange."
        },
        "new_ephemeral_did": {
          "type": "string",
          "pattern": "^did:",
          "description": "A fresh ephemeral DID for this PQ session (never reused)."
        },
        "new_ephemeral_did_document": {
          "type": "object"
        },
        "binding": {
          "type": "object",
          "required": [
            "alg",
            "kid",
            "value"
          ],
          "properties": {
            "alg": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        "reason": {
          "type": "string",
          "description": "ttl_expiry, message_count_threshold, compromise_suspected, policy, or free text."
        },
        "overlap_seconds": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "current_generation",
        "new_generation",
        "new_ephemeral_did"
      ]
    }
  }
}
