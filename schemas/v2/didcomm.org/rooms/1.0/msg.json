{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rooms/1.0/msg",
  "description": "Carries MLS application ciphertext, opaque to the host and routers. The MLS AAD carries mls_msg_id for deduplication.",
  "type": "object",
  "required": [
    "id",
    "type",
    "attachments",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/rooms/1.0/msg"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "room_did": {
          "type": "string",
          "pattern": "^did:[a-z0-9]+:[^#]+$",
          "description": "The room's DID."
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "The MLS epoch."
        }
      },
      "required": [
        "room_did",
        "epoch"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      },
      "description": "The MLS ciphertext (application/mls-message).",
      "minItems": 1
    }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "description": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "lastmod_time": {
          "type": [
            "integer",
            "string"
          ]
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "jws"
              ]
            },
            {
              "required": [
                "hash"
              ]
            },
            {
              "required": [
                "links"
              ]
            },
            {
              "required": [
                "base64"
              ]
            },
            {
              "required": [
                "json"
              ]
            }
          ],
          "properties": {
            "jws": {
              "type": "object"
            },
            "hash": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "base64": {
              "type": "string"
            },
            "json": {}
          }
        }
      }
    }
  }
}
