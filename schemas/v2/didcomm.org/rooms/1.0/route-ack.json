{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rooms/1.0/route-ack",
  "description": "The host accepts (part of) a router's reach set, with a lease.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/rooms/1.0/route-ack"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "accepted_reach": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lease_exp": {
          "type": "string"
        }
      },
      "required": [
        "accepted_reach"
      ]
    }
  }
}
