{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow/1.0/advance",
  "description": "Fires an event on an instance: guard, optional action, persisted state. Idempotent per idempotency_key; fields named in $transient are used for this cycle only.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/workflow/1.0/advance"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "instance_id": {
          "type": "string",
          "description": "The workflow instance's id (thid SHOULD equal it)."
        },
        "event": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "input": {
          "type": "object"
        },
        "$transient": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "instance_id",
        "event"
      ]
    }
  }
}
