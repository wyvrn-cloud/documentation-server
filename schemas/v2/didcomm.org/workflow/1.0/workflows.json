{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow/1.0/workflows",
  "description": "The templates the requester may see, one entry per template id. (didcomm.org workflow/1.0)",
  "type": "object",
  "required": [
    "id",
    "type",
    "body",
    "thid"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/workflow/1.0/workflows"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "required": [
        "workflows"
      ],
      "properties": {
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "template_id",
              "versions"
            ],
            "properties": {
              "template_id": {
                "type": "string"
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "title": {
                "type": "string"
              },
              "hash": {
                "type": "string",
                "description": "When include_hash and a single version."
              }
            }
          }
        },
        "paging": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "next_offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
