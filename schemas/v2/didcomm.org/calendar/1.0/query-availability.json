{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calendar/1.0/query-availability",
  "description": "Asks for free/busy information in a range, without event details.",
  "type": "object",
  "required": [
    "id",
    "type",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/calendar/1.0/query-availability"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "range": {
          "type": "object",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "string",
              "description": "ISO 8601, UTC."
            },
            "end": {
              "type": "string",
              "description": "ISO 8601, UTC."
            }
          }
        },
        "timezone": {
          "type": "string"
        },
        "granularity_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "type": "string"
        }
      },
      "required": [
        "range"
      ]
    }
  }
}
