{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calendar/1.0/update",
  "description": "Changes a confirmed event; sequence MUST be incremented. changes holds only the modified fields.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/calendar/1.0/update"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "description": "The event's id (evt-<uuid>); also the thid of every message about it."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic; incremented on every update. Messages with a lower sequence than last seen MUST be rejected."
        },
        "changes": {
          "type": "object",
          "minProperties": 1
        },
        "reason": {
          "type": "string"
        },
        "require_re_rsvp": {
          "type": "boolean",
          "description": "When true, every participant's status resets to pending."
        }
      },
      "required": [
        "event_id",
        "sequence",
        "changes"
      ]
    }
  }
}
