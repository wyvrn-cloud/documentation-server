{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calendar/1.0/decline",
  "description": "Declines an invitation, optionally suggesting another time.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/calendar/1.0/decline"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "description": "The event's id (evt-<uuid>); also the thid of every message about it."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "description": "Monotonic; incremented on every update. Messages with a lower sequence than last seen MUST be rejected."
        },
        "reason": {
          "type": "string",
          "description": "scheduling-conflict, unavailable, not-interested, or free text."
        },
        "counter_propose": {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "description": "ISO 8601, UTC."
            },
            "end": {
              "type": "string",
              "description": "ISO 8601, UTC."
            },
            "timezone": {
              "type": "string",
              "description": "IANA time zone, for display."
            }
          }
        },
        "signed_rsvp": {
          "type": [
            "string",
            "null"
          ],
          "description": "A JWS over {event_id, sequence, response, from_did, timestamp}; required when the event set require_signed_rsvp."
        }
      },
      "required": [
        "event_id",
        "sequence"
      ]
    }
  }
}
