{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calendar/1.0/propose",
  "description": "Suggests an event with time options to vote on (poll-based scheduling), or counter-proposes.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/calendar/1.0/propose"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "description": "The event's id (evt-<uuid>); also the thid of every message about it."
        },
        "title": {
          "type": "string"
        },
        "type": {
          "enum": [
            "meeting",
            "call",
            "deadline",
            "reminder",
            "task",
            "payment"
          ]
        },
        "time_options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "option_id",
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "string",
                "description": "ISO 8601, UTC."
              },
              "end": {
                "type": "string",
                "description": "ISO 8601, UTC."
              },
              "timezone": {
                "type": "string",
                "description": "IANA time zone, for display."
              },
              "option_id": {
                "type": "string"
              }
            }
          }
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "$ref"
              ],
              "properties": {
                "$ref": {
                  "type": "object",
                  "required": [
                    "vault_id",
                    "doc_id",
                    "digest"
                  ],
                  "properties": {
                    "vault_id": {
                      "type": "string"
                    },
                    "doc_id": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string"
                    }
                  }
                }
              },
              "description": "A pointer into the event's encrypted data vault."
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "$ref"
              ],
              "properties": {
                "$ref": {
                  "type": "object",
                  "required": [
                    "vault_id",
                    "doc_id",
                    "digest"
                  ],
                  "properties": {
                    "vault_id": {
                      "type": "string"
                    },
                    "doc_id": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string"
                    }
                  }
                }
              },
              "description": "A pointer into the event's encrypted data vault."
            }
          ]
        },
        "call_config": {
          "type": "object",
          "description": "WebRTC pre-negotiation (as WebRTC 1.0 propose); present when type is call.",
          "properties": {
            "topology": {
              "type": "string"
            },
            "media": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "policy": {
              "type": "string"
            },
            "ice_servers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "quorum": {
          "type": "object",
          "properties": {
            "min_accept": {
              "type": "integer",
              "minimum": 1
            },
            "deadline": {
              "type": "string",
              "description": "ISO 8601, UTC."
            }
          }
        },
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "offset_minutes",
              "channel"
            ],
            "properties": {
              "offset_minutes": {
                "type": "integer",
                "description": "Negative: before the start."
              },
              "channel": {
                "type": "string"
              },
              "action": {
                "type": "string"
              }
            }
          }
        },
        "recurrence": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "rrule": {
              "type": "string",
              "description": "RFC 5545 RRULE (FREQ, UNTIL, COUNT, INTERVAL, BYDAY, BYMONTHDAY, BYMONTH, WKST); at most 365 instances."
            },
            "exceptions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "exdates": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "ISO 8601, UTC."
              }
            }
          }
        },
        "sensitivity": {
          "enum": [
            "public",
            "private",
            "confidential"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "event_id",
        "title",
        "type",
        "time_options"
      ]
    }
  }
}
