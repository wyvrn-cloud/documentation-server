{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "calendar/1.0/reminder",
  "description": "A reminder before an event; for calls, call_trigger carries fresh WebRTC configuration.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/calendar/1.0/reminder"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "description": "The event's id (evt-<uuid>); also the thid of every message about it."
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "description": "ISO 8601, UTC."
        },
        "timezone": {
          "type": "string"
        },
        "offset_minutes": {
          "type": "integer"
        },
        "action": {
          "type": "string",
          "description": "join_call, review_agenda, submit_payment, acknowledge."
        },
        "call_trigger": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "preconfig": {
              "type": "object",
              "description": "WebRTC pre-negotiation (as WebRTC 1.0 propose); present when type is call.",
              "properties": {
                "topology": {
                  "type": "string"
                },
                "media": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "policy": {
                  "type": "string"
                },
                "ice_servers": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      },
      "required": [
        "event_id"
      ]
    }
  }
}
