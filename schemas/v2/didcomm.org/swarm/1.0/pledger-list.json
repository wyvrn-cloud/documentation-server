{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm/1.0/pledger-list",
  "description": "Pledgers matching a find-pledgers request. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/swarm/1.0/pledger-list"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "pledgers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "peer_did"
            ],
            "properties": {
              "peer_did": {
                "type": "string"
              },
              "available_capacity_bytes": {
                "type": "integer"
              },
              "rate_per_gb_month": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "uptime_30d": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "supported_extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "required": [
        "pledgers"
      ]
    }
  }
}
