{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm/1.0/store-request",
  "description": "Asks a pledger to keep some erasure-coded shards of an encrypted blob; the shards come as attachments. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/swarm/1.0/store-request"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "description": "The blob's id (also the thid of its messages)."
        },
        "content_digest": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "shard_params": {
          "type": "object",
          "required": [
            "algorithm",
            "k",
            "m",
            "merkle_root"
          ],
          "properties": {
            "algorithm": {
              "type": "string",
              "description": "e.g. reed-solomon@1."
            },
            "k": {
              "type": "integer",
              "minimum": 1
            },
            "m": {
              "type": "integer",
              "minimum": 1
            },
            "shard_size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "merkle_root": {
              "type": "string"
            }
          }
        },
        "shard_assignment": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "ttl_expiry": {
          "type": "string"
        },
        "replication_factor": {
          "type": "integer",
          "minimum": 1
        },
        "payment_offer": {
          "type": "object",
          "properties": {
            "rate_per_gb_month": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "currency": {
              "type": "string"
            }
          }
        },
        "audit_policy": {
          "type": "object",
          "properties": {
            "challenge_interval_hours": {
              "type": "integer"
            },
            "challenge_timeout_seconds": {
              "type": "integer"
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pthid": {
          "type": "string"
        }
      },
      "required": [
        "blob_id",
        "content_digest",
        "shard_params",
        "shard_assignment"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      },
      "description": "The assigned shards' ciphertext.",
      "minItems": 1
    }
  },
  "$defs": {
    "attachment": {
      "type": "object",
      "required": [
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "description": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "lastmod_time": {
          "type": [
            "integer",
            "string"
          ]
        },
        "byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "object",
          "anyOf": [
            {
              "required": [
                "jws"
              ]
            },
            {
              "required": [
                "hash"
              ]
            },
            {
              "required": [
                "links"
              ]
            },
            {
              "required": [
                "base64"
              ]
            },
            {
              "required": [
                "json"
              ]
            }
          ],
          "properties": {
            "jws": {
              "type": "object"
            },
            "hash": {
              "type": "string"
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "base64": {
              "type": "string"
            },
            "json": {}
          }
        }
      }
    }
  }
}
