{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm/1.0/pledge-status",
  "description": "The curator's health summary of a blob's pledges. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/swarm/1.0/pledge-status"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "description": "The blob's id (also the thid of its messages)."
        },
        "as_of": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "properties": {
            "replication_factor_target": {
              "type": "integer"
            },
            "replication_factor_current": {
              "type": "integer"
            },
            "healthy_shards": {
              "type": "integer"
            },
            "missing_shards": {
              "type": "integer"
            }
          }
        },
        "pledges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "peer_did",
              "status"
            ],
            "properties": {
              "peer_did": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "last_audit": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "blob_id",
        "pledges"
      ]
    }
  }
}
