{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm/1.0/retrieve-request",
  "description": "Asks for shards back (recovery), authorized by a ZCAP-LD invocation and a Signing 1.0 ticket. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type",
    "thid",
    "body"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/swarm/1.0/retrieve-request"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "blob_id": {
          "type": "string",
          "description": "The blob's id (also the thid of its messages)."
        },
        "shard_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "capability_invocation": {
          "type": "string"
        },
        "ticket": {
          "type": "object",
          "required": [
            "typ",
            "session_id",
            "ctr"
          ],
          "properties": {
            "typ": {
              "type": "string"
            },
            "session_id": {
              "type": "string"
            },
            "scope": {
              "type": "string"
            },
            "device": {
              "type": "string"
            },
            "ctr": {
              "type": "integer",
              "minimum": 0
            },
            "exp": {
              "type": "string"
            },
            "cap": {
              "type": "integer"
            }
          }
        },
        "ticket_sig": {
          "type": "object",
          "required": [
            "kid",
            "value"
          ],
          "properties": {
            "suite": {
              "type": "string"
            },
            "kid": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "blob_id",
        "shard_ids",
        "capability_invocation",
        "ticket",
        "ticket_sig"
      ]
    }
  }
}
