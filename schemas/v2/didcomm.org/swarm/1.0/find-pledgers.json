{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "swarm/1.0/find-pledgers",
  "description": "Asks a coordinator (a non-authoritative directory) for pledgers matching some criteria. Authcrypt.",
  "type": "object",
  "required": [
    "id",
    "type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender."
    },
    "type": {
      "const": "https://didcomm.org/swarm/1.0/find-pledgers"
    },
    "from": {
      "type": "string",
      "pattern": "^did:[a-z0-9]+:[^#]+$",
      "description": "Sender DID. REQUIRED when the message is authcrypted."
    },
    "to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^did:[a-z0-9]+:[^#]+$"
      },
      "description": "Intended recipient DIDs."
    },
    "thid": {
      "type": "string",
      "description": "Thread id; the id of the message that started the thread."
    },
    "pthid": {
      "type": "string",
      "description": "Parent thread id."
    },
    "created_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "expires_time": {
      "type": "integer",
      "minimum": 0,
      "description": "UTC epoch seconds."
    },
    "body": {
      "type": "object",
      "properties": {
        "min_capacity_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "max_rate_per_gb_month": {
          "type": "string"
        },
        "min_ttl_days": {
          "type": "integer",
          "minimum": 0
        },
        "preferred_regions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude_dids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
