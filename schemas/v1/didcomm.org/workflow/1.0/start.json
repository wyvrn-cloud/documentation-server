{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow/1.0/start",
  "description": "Starts a workflow instance from a template, bound to the connection it arrives on. The thread id is the instance id. Answered with a status (state pending while queued), or a problem-report; an unknown template makes the processor send fetch-template on the same thread first. DIDComm v1 as sent by @ajna-inc/workflow (Credo 0.5): the fields sit under body, ~thread.thid carries the thread id, and requests set ~transport.return_route to thread.",
  "type": "object",
  "required": [
    "@id",
    "@type",
    "body"
  ],
  "properties": {
    "@id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender (Aries RFC 0008)."
    },
    "@type": {
      "enum": [
        "https://didcomm.org/workflow/1.0/start",
        "did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/workflow/1.0/start"
      ],
      "description": "The did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/ form is the legacy equivalent (Aries RFC 0348)."
    },
    "~thread": {
      "$ref": "#/$defs/thread"
    },
    "~l10n": {
      "$ref": "#/$defs/l10n"
    },
    "~timing": {
      "$ref": "#/$defs/timing"
    },
    "~transport": {
      "$ref": "#/$defs/transport"
    },
    "~please_ack": {
      "$ref": "#/$defs/please_ack"
    },
    "~service": {
      "$ref": "#/$defs/service"
    },
    "~trace": {
      "$ref": "#/$defs/trace"
    },
    "body": {
      "type": "object",
      "required": [
        "template_id"
      ],
      "properties": {
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string",
          "description": "Latest when omitted."
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow instance's id. The thread id MUST equal it."
        },
        "participants": {
          "$ref": "#/$defs/participants"
        },
        "context": {
          "type": "object",
          "description": "Initial context. A vault-backed field is a {\"$ref\": {vault_id, doc_id, digest}} pointer.",
          "additionalProperties": {}
        },
        "connection_id": {
          "type": "string",
          "description": "Ignored: the processor binds the instance to the inbound connection. The definition says not to send it; @ajna-inc/workflow does."
        },
        "vault_ref": {
          "type": "object",
          "required": [
            "vault_id"
          ],
          "properties": {
            "vault_id": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            }
          }
        },
        "allow_discover": {
          "type": "boolean",
          "default": true
        },
        "template_hash": {
          "type": "string",
          "description": "Integrity hint; sent as prefer_hash in a resulting fetch-template."
        },
        "multiplicity_hint": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "thread": {
      "type": "object",
      "description": "~thread decorator (Aries RFC 0008). thid: the @id of the message that started the thread; pthid: the parent thread's id.",
      "properties": {
        "thid": {
          "type": "string"
        },
        "pthid": {
          "type": "string"
        },
        "sender_order": {
          "type": "integer",
          "minimum": 0
        },
        "received_orders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "goal_code": {
          "type": "string"
        }
      }
    },
    "l10n": {
      "type": "object",
      "description": "~l10n decorator (Aries RFC 0043): the message's locale (locale), or, for advanced cases, locales, catalogs and per-field localization.",
      "properties": {
        "locale": {
          "type": "string"
        },
        "locales": {
          "type": "object"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "description": "~timing decorator (Aries RFC 0032). Times are ISO 8601 UTC.",
      "properties": {
        "in_time": {
          "type": "string"
        },
        "out_time": {
          "type": "string"
        },
        "stale_time": {
          "type": "string"
        },
        "expires_time": {
          "type": "string"
        },
        "delay_milli": {
          "type": "integer",
          "minimum": 0
        },
        "wait_until_time": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "description": "~transport decorator (Aries RFC 0092): return_route asks for replies on the same connection.",
      "properties": {
        "return_route": {
          "enum": [
            "none",
            "all",
            "thread"
          ]
        },
        "return_route_thread": {
          "type": "string"
        }
      }
    },
    "please_ack": {
      "type": "object",
      "description": "~please_ack decorator (retired Aries RFC 0317): asks for an ack on receipt and/or outcome.",
      "properties": {
        "on": {
          "type": "array",
          "items": {
            "enum": [
              "RECEIPT",
              "OUTCOME"
            ]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "description": "~service decorator (Aries RFC 0056): where to send a reply when there is no connection.",
      "properties": {
        "recipientKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routingKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceEndpoint": {
          "type": "string"
        }
      }
    },
    "trace": {
      "type": "object",
      "description": "~trace decorator (Aries RFC 0034).",
      "properties": {
        "target": {
          "type": "string"
        },
        "full_thread": {
          "type": "boolean"
        },
        "trace_reports": {
          "type": "array"
        }
      }
    },
    "participants": {
      "type": "object",
      "description": "Participants by role key (issuer, holder, ...). The processor fills issuer and holder from the connection when missing.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string"
          }
        }
      }
    }
  }
}
