{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow/1.0/template",
  "description": "The full, authoritative template, on the fetch-template's thread; the recipient validates and stores it, then proceeds with any pending start. DIDComm v1 as sent by @ajna-inc/workflow (Credo 0.5): the fields sit under body, ~thread.thid carries the thread id, and requests set ~transport.return_route to thread.",
  "type": "object",
  "required": [
    "@id",
    "@type",
    "body",
    "~thread"
  ],
  "properties": {
    "@id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender (Aries RFC 0008)."
    },
    "@type": {
      "enum": [
        "https://didcomm.org/workflow/1.0/template",
        "did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/workflow/1.0/template"
      ],
      "description": "The did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/ form is the legacy equivalent (Aries RFC 0348)."
    },
    "~thread": {
      "allOf": [
        {
          "$ref": "#/$defs/thread"
        },
        {
          "required": [
            "thid"
          ]
        }
      ]
    },
    "~l10n": {
      "$ref": "#/$defs/l10n"
    },
    "~timing": {
      "$ref": "#/$defs/timing"
    },
    "~transport": {
      "$ref": "#/$defs/transport"
    },
    "~please_ack": {
      "$ref": "#/$defs/please_ack"
    },
    "~service": {
      "$ref": "#/$defs/service"
    },
    "~trace": {
      "$ref": "#/$defs/trace"
    },
    "body": {
      "type": "object",
      "required": [
        "template"
      ],
      "properties": {
        "template": {
          "$ref": "#/$defs/workflow_template"
        }
      }
    }
  },
  "$defs": {
    "thread": {
      "type": "object",
      "description": "~thread decorator (Aries RFC 0008). thid: the @id of the message that started the thread; pthid: the parent thread's id.",
      "properties": {
        "thid": {
          "type": "string"
        },
        "pthid": {
          "type": "string"
        },
        "sender_order": {
          "type": "integer",
          "minimum": 0
        },
        "received_orders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "goal_code": {
          "type": "string"
        }
      }
    },
    "l10n": {
      "type": "object",
      "description": "~l10n decorator (Aries RFC 0043): the message's locale (locale), or, for advanced cases, locales, catalogs and per-field localization.",
      "properties": {
        "locale": {
          "type": "string"
        },
        "locales": {
          "type": "object"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "description": "~timing decorator (Aries RFC 0032). Times are ISO 8601 UTC.",
      "properties": {
        "in_time": {
          "type": "string"
        },
        "out_time": {
          "type": "string"
        },
        "stale_time": {
          "type": "string"
        },
        "expires_time": {
          "type": "string"
        },
        "delay_milli": {
          "type": "integer",
          "minimum": 0
        },
        "wait_until_time": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "description": "~transport decorator (Aries RFC 0092): return_route asks for replies on the same connection.",
      "properties": {
        "return_route": {
          "enum": [
            "none",
            "all",
            "thread"
          ]
        },
        "return_route_thread": {
          "type": "string"
        }
      }
    },
    "please_ack": {
      "type": "object",
      "description": "~please_ack decorator (retired Aries RFC 0317): asks for an ack on receipt and/or outcome.",
      "properties": {
        "on": {
          "type": "array",
          "items": {
            "enum": [
              "RECEIPT",
              "OUTCOME"
            ]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "description": "~service decorator (Aries RFC 0056): where to send a reply when there is no connection.",
      "properties": {
        "recipientKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routingKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceEndpoint": {
          "type": "string"
        }
      }
    },
    "trace": {
      "type": "object",
      "description": "~trace decorator (Aries RFC 0034).",
      "properties": {
        "target": {
          "type": "string"
        },
        "full_thread": {
          "type": "boolean"
        },
        "trace_reports": {
          "type": "array"
        }
      }
    },
    "workflow_template": {
      "type": "object",
      "description": "A workflow template: a versioned state machine (states, transitions with JMESPath guards and actions), the catalog of credential and proof profiles its actions use, and its UI. Shape as implemented by @ajna-inc/workflow (Credo); it rejects keys outside these at the top level, sensitivity included.",
      "required": [
        "template_id",
        "version",
        "title",
        "instance_policy",
        "states",
        "transitions",
        "catalog",
        "actions"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "Semver."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "instance_policy": {
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "singleton_per_connection",
                "multi_per_connection"
              ]
            },
            "multiplicity_key": {
              "type": "string",
              "description": "JMESPath over {context} that deduplicates instances in multi_per_connection mode."
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "order": {
                "type": "number"
              },
              "icon": {
                "type": "string"
              }
            }
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "description": "Exactly the states of the machine; one of type start is required.",
          "contains": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "start"
              }
            }
          },
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "start",
                  "normal",
                  "final"
                ]
              },
              "section": {
                "type": "string",
                "description": "A sections[].name."
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "on"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "on": {
                "type": "string",
                "description": "The event name advance sends."
              },
              "guard": {
                "type": "string",
                "description": "JMESPath over {context, participants, artifacts}; the transition is enabled when truthy."
              },
              "action": {
                "type": "string",
                "description": "An actions[].key."
              }
            }
          }
        },
        "catalog": {
          "type": "object",
          "properties": {
            "credential_profiles": {
              "type": "object",
              "description": "Referenced from actions as cp.<key>.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "cred_def_id",
                  "attribute_plan",
                  "to_ref"
                ],
                "properties": {
                  "cred_def_id": {
                    "type": "string"
                  },
                  "attribute_plan": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/attribute_spec"
                    }
                  },
                  "to_ref": {
                    "type": "string",
                    "description": "The participant key (e.g. holder) the credential goes to."
                  },
                  "options": {
                    "type": "object",
                    "description": "e.g. comment."
                  }
                }
              }
            },
            "proof_profiles": {
              "type": "object",
              "description": "Referenced from actions as pp.<key>.",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "to_ref"
                ],
                "properties": {
                  "schema_id": {
                    "type": "string"
                  },
                  "cred_def_id": {
                    "type": "string"
                  },
                  "requested_attributes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "requested_predicates": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "p_type",
                        "p_value"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "p_type": {
                          "type": "string"
                        },
                        "p_value": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "to_ref": {
                    "type": "string"
                  },
                  "options": {
                    "type": "object"
                  }
                }
              }
            },
            "defaults": {
              "type": "object"
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "typeURI"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "typeURI": {
                "type": "string",
                "description": "A DIDComm message type (e.g. https://didcomm.org/issue-credential/2.0/offer-credential) or a local action (https://didcomm.org/workflow/actions/state:set@1)."
              },
              "profile_ref": {
                "type": "string",
                "pattern": "^(cp|pp)\\.",
                "description": "cp.<credential profile> or pp.<proof profile>."
              },
              "staticInput": {
                "description": "Input for local actions; for state:set@1, the object merged into context."
              }
            }
          }
        },
        "display_hints": {
          "$ref": "#/$defs/display_hints"
        },
        "sensitivity": {
          "type": "object",
          "description": "Classification of context fields (didcomm.org definition). Not accepted by @ajna-inc/workflow 0.5.",
          "properties": {
            "default": {
              "$ref": "#/$defs/sensitivity_class"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/sensitivity_class"
              }
            }
          }
        }
      }
    },
    "attribute_spec": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "source",
            "path"
          ],
          "properties": {
            "source": {
              "const": "context"
            },
            "path": {
              "type": "string",
              "description": "Dot path into context."
            },
            "required": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "value"
          ],
          "properties": {
            "source": {
              "const": "static"
            },
            "value": {},
            "required": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "source",
            "expr"
          ],
          "properties": {
            "source": {
              "const": "compute"
            },
            "expr": {
              "type": "string",
              "description": "JMESPath over {context, participants, artifacts, now}."
            },
            "required": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "display_hints": {
      "type": "object",
      "description": "Workflow UI 1.0 hints: UI items per state, optionally per UI profile, and the media they use.",
      "properties": {
        "ui_version": {
          "type": "string",
          "default": "1.0"
        },
        "states": {
          "type": "object",
          "description": "UI items by state name.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ui_item"
            }
          }
        },
        "profiles": {
          "type": "object",
          "description": "Per UI profile (sender, receiver) overrides of states; used instead of states when the viewer's profile has an entry for the current state.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "states": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/ui_item"
                  }
                }
              }
            }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ui_asset"
          }
        },
        "sensitivity_behavior": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "render": {
                "enum": [
                  "masked",
                  "masked_toggle",
                  "visible"
                ]
              },
              "mask_format": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ui_item": {
      "type": "object",
      "description": "A Workflow UI 1.0 item. type picks the component; the processor applies the control keys (audience, profile, showWhen, enabledWhen, bind) and {{ JMESPath }} interpolation before it sends items in a status. Items of type button or submit-button with an event make up the action_menu. Renderers ignore types they don't know. Types the Bifold wallet renders: title, text, image, video, button, submit-button, form, text-field, check-box, checkbox, radio, drop-down, dropdown, date, slider, mcq, multiple-choice, rating, information, warning, error, pass, fail, badge, chip, chip-row, pill-row, divider, spacer, row, section, card, tile, carousel, h-scroll, timeline, basic-table, bar-chart, pie-chart, donut-chart, gauge, dial, map, calendar, share-entry.",
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "description": "The transition event an advance sends when the item is activated."
        },
        "form-id": {
          "type": "string",
          "description": "A form field's key in advance.input."
        },
        "input_schema": {
          "type": "object",
          "description": "On a submit-button: a JSON Schema for the form the renderer shows; the values go in advance.input, shaped by the schema."
        },
        "audience": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Shown only to a viewer matching one of: a role, participant:<key>, or a UI profile."
        },
        "profile": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Shown only for these UI profiles (sender, receiver)."
        },
        "showWhen": {
          "type": "string",
          "description": "JMESPath over {context, participants, artifacts}; the item is dropped when falsy."
        },
        "enabledWhen": {
          "type": "string",
          "description": "JMESPath; when falsy the processor sets disabled: true."
        },
        "bind": {
          "type": "string",
          "description": "JMESPath whose result the processor puts in value."
        },
        "value": {},
        "disabled": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "description": "Key into display_hints.assets."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ui_item"
          }
        },
        "row_template": {
          "$ref": "#/$defs/ui_item"
        }
      }
    },
    "ui_asset": {
      "type": "object",
      "required": [
        "mediaType"
      ],
      "properties": {
        "mediaType": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "attachmentId": {
          "type": "string"
        }
      }
    },
    "sensitivity_class": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "secret",
            "pii",
            "plain"
          ],
          "default": "plain"
        },
        "storage": {
          "enum": [
            "vault",
            "encrypted",
            "plain"
          ],
          "default": "plain"
        }
      }
    }
  }
}
