{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow/1.0/status",
  "description": "Asks for an instance's status, or answers with it on the request's thread (a body with a string state is an answer). The processor also answers start, advance, pause, resume, cancel and complete with one. DIDComm v1 as sent by @ajna-inc/workflow (Credo 0.5): the fields sit under body, ~thread.thid carries the thread id, and requests set ~transport.return_route to thread.",
  "type": "object",
  "required": [
    "@id",
    "@type",
    "body"
  ],
  "properties": {
    "@id": {
      "type": "string",
      "minLength": 1,
      "description": "Message ID, unique to the sender (Aries RFC 0008)."
    },
    "@type": {
      "enum": [
        "https://didcomm.org/workflow/1.0/status",
        "did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/workflow/1.0/status"
      ],
      "description": "The did:sov:BzCbsNYhMrjHiqZDTUASHg;spec/ form is the legacy equivalent (Aries RFC 0348)."
    },
    "~thread": {
      "$ref": "#/$defs/thread"
    },
    "~l10n": {
      "$ref": "#/$defs/l10n"
    },
    "~timing": {
      "$ref": "#/$defs/timing"
    },
    "~transport": {
      "$ref": "#/$defs/transport"
    },
    "~please_ack": {
      "$ref": "#/$defs/please_ack"
    },
    "~service": {
      "$ref": "#/$defs/service"
    },
    "~trace": {
      "$ref": "#/$defs/trace"
    },
    "body": {
      "type": "object",
      "properties": {
        "include_actions": {
          "type": "boolean",
          "default": true
        },
        "include_ui": {
          "type": "boolean",
          "default": true
        },
        "viewer": {
          "type": "object",
          "description": "Who the UI is for; derived from the connection when omitted.",
          "properties": {
            "role": {
              "type": "string"
            },
            "connection_id": {
              "type": "string"
            },
            "did": {
              "type": "string"
            },
            "participantKey": {
              "type": "string"
            }
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "e.g. ui:video, ui:table."
        },
        "resolve_vault_refs": {
          "type": "boolean",
          "default": false
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "description": "The workflow instance's id. The thread id MUST equal it."
        },
        "template_id": {
          "type": "string"
        },
        "template_version": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "description": "The current state; pending while a start is queued and the instance doesn't exist yet."
        },
        "section": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "canceled",
            "completed",
            "error"
          ]
        },
        "allowed_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Events whose transitions leave the current state and whose guards pass."
        },
        "action_menu": {
          "type": "array",
          "description": "The button and submit-button items of ui, for clients that don't render ui.",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "event": {
                "type": "string"
              }
            }
          }
        },
        "artifacts": {
          "type": "object",
          "description": "Outputs of earlier actions (e.g. credential or proof exchange record ids)."
        },
        "context": {
          "type": "object"
        },
        "participants": {
          "$ref": "#/$defs/participants"
        },
        "ui": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ui_item"
          },
          "description": "The state's UI items, filtered and bound for the viewer (when include_ui)."
        },
        "ui_profile": {
          "type": "string",
          "description": "The UI profile used: sender (issuer side) or receiver (holder side)."
        },
        "assets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ui_asset"
          },
          "description": "The display_hints.assets that ui references."
        },
        "connection_id": {
          "type": "string",
          "description": "Processor-local; meaningless to the recipient."
        },
        "connection": {
          "type": "object",
          "description": "Processor-local view of the connection.",
          "properties": {
            "id": {
              "type": "string"
            },
            "myDid": {
              "type": "string"
            },
            "theirDid": {
              "type": "string"
            }
          }
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "instance_id"
      ]
    }
  },
  "if": {
    "properties": {
      "body": {
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "type": "string"
          }
        }
      }
    },
    "required": [
      "body"
    ]
  },
  "then": {
    "required": [
      "~thread"
    ],
    "properties": {
      "~thread": {
        "required": [
          "thid"
        ]
      }
    }
  },
  "$defs": {
    "thread": {
      "type": "object",
      "description": "~thread decorator (Aries RFC 0008). thid: the @id of the message that started the thread; pthid: the parent thread's id.",
      "properties": {
        "thid": {
          "type": "string"
        },
        "pthid": {
          "type": "string"
        },
        "sender_order": {
          "type": "integer",
          "minimum": 0
        },
        "received_orders": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "goal_code": {
          "type": "string"
        }
      }
    },
    "l10n": {
      "type": "object",
      "description": "~l10n decorator (Aries RFC 0043): the message's locale (locale), or, for advanced cases, locales, catalogs and per-field localization.",
      "properties": {
        "locale": {
          "type": "string"
        },
        "locales": {
          "type": "object"
        },
        "catalogs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "description": "~timing decorator (Aries RFC 0032). Times are ISO 8601 UTC.",
      "properties": {
        "in_time": {
          "type": "string"
        },
        "out_time": {
          "type": "string"
        },
        "stale_time": {
          "type": "string"
        },
        "expires_time": {
          "type": "string"
        },
        "delay_milli": {
          "type": "integer",
          "minimum": 0
        },
        "wait_until_time": {
          "type": "string"
        }
      }
    },
    "transport": {
      "type": "object",
      "description": "~transport decorator (Aries RFC 0092): return_route asks for replies on the same connection.",
      "properties": {
        "return_route": {
          "enum": [
            "none",
            "all",
            "thread"
          ]
        },
        "return_route_thread": {
          "type": "string"
        }
      }
    },
    "please_ack": {
      "type": "object",
      "description": "~please_ack decorator (retired Aries RFC 0317): asks for an ack on receipt and/or outcome.",
      "properties": {
        "on": {
          "type": "array",
          "items": {
            "enum": [
              "RECEIPT",
              "OUTCOME"
            ]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "description": "~service decorator (Aries RFC 0056): where to send a reply when there is no connection.",
      "properties": {
        "recipientKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "routingKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "serviceEndpoint": {
          "type": "string"
        }
      }
    },
    "trace": {
      "type": "object",
      "description": "~trace decorator (Aries RFC 0034).",
      "properties": {
        "target": {
          "type": "string"
        },
        "full_thread": {
          "type": "boolean"
        },
        "trace_reports": {
          "type": "array"
        }
      }
    },
    "participants": {
      "type": "object",
      "description": "Participants by role key (issuer, holder, ...). The processor fills issuer and holder from the connection when missing.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string"
          }
        }
      }
    },
    "ui_item": {
      "type": "object",
      "description": "A Workflow UI 1.0 item. type picks the component; the processor applies the control keys (audience, profile, showWhen, enabledWhen, bind) and {{ JMESPath }} interpolation before it sends items in a status. Items of type button or submit-button with an event make up the action_menu. Renderers ignore types they don't know. Types the Bifold wallet renders: title, text, image, video, button, submit-button, form, text-field, check-box, checkbox, radio, drop-down, dropdown, date, slider, mcq, multiple-choice, rating, information, warning, error, pass, fail, badge, chip, chip-row, pill-row, divider, spacer, row, section, card, tile, carousel, h-scroll, timeline, basic-table, bar-chart, pie-chart, donut-chart, gauge, dial, map, calendar, share-entry.",
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "event": {
          "type": "string",
          "description": "The transition event an advance sends when the item is activated."
        },
        "form-id": {
          "type": "string",
          "description": "A form field's key in advance.input."
        },
        "audience": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Shown only to a viewer matching one of: a role, participant:<key>, or a UI profile."
        },
        "profile": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          },
          "description": "Shown only for these UI profiles (sender, receiver)."
        },
        "showWhen": {
          "type": "string",
          "description": "JMESPath over {context, participants, artifacts}; the item is dropped when falsy."
        },
        "enabledWhen": {
          "type": "string",
          "description": "JMESPath; when falsy the processor sets disabled: true."
        },
        "bind": {
          "type": "string",
          "description": "JMESPath whose result the processor puts in value."
        },
        "value": {},
        "disabled": {
          "type": "boolean"
        },
        "asset": {
          "type": "string",
          "description": "Key into display_hints.assets."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ui_item"
          }
        },
        "row_template": {
          "$ref": "#/$defs/ui_item"
        }
      }
    },
    "ui_asset": {
      "type": "object",
      "required": [
        "mediaType"
      ],
      "properties": {
        "mediaType": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "attachmentId": {
          "type": "string"
        }
      }
    }
  }
}
