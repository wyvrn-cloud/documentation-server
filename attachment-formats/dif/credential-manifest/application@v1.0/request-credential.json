{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/dif/credential-manifest/application@v1.0/request-credential.json",
  "title": "DIF Credential Application (dif/credential-manifest/application@v1.0) in request-credential",
  "type": "object",
  "required": [
    "credential_application"
  ],
  "properties": {
    "@context": {
      "description": "JSON-LD context.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "credential_application": {
      "type": "object",
      "required": [
        "id",
        "manifest_id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "manifest_id": {
          "type": "string"
        },
        "format": {
          "type": "object"
        }
      }
    },
    "presentation_submission": {
      "type": "object",
      "required": [
        "descriptor_map"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "definition_id": {
          "type": "string"
        },
        "descriptor_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "path_nested": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "verifiableCredential": {
      "type": "array"
    },
    "proof": {
      "description": "One proof or a set of them.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type"
            ]
          }
        }
      ]
    }
  }
}
