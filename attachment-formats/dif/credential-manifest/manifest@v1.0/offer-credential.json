{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/dif/credential-manifest/manifest@v1.0/offer-credential.json",
  "title": "DIF Credential Manifest (dif/credential-manifest/manifest@v1.0) in offer-credential",
  "type": "object",
  "required": [
    "credential_manifest"
  ],
  "properties": {
    "options": {
      "type": "object",
      "properties": {
        "challenge": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        }
      }
    },
    "credential_manifest": {
      "type": "object",
      "required": [
        "id",
        "issuer",
        "output_descriptors"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "issuer": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "styles": {
              "type": "object"
            }
          }
        },
        "output_descriptors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "schema"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "presentation_definition": {
          "description": "A DIF Presentation Exchange presentation definition.",
          "type": "object",
          "required": [
            "input_descriptors"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "purpose": {
              "type": "string"
            },
            "format": {
              "type": "object"
            },
            "submission_requirements": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "frame": {
              "type": "object"
            },
            "input_descriptors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "purpose": {
                    "type": "string"
                  },
                  "group": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "schema": {},
                  "format": {
                    "type": "object"
                  },
                  "constraints": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "format": {
          "type": "object"
        }
      }
    }
  }
}
