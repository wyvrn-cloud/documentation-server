{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/aries/ld-proof-vc-detail@v1.0/propose-credential.json",
  "title": "JSON-LD credential detail (Linked Data Proof) (aries/ld-proof-vc-detail@v1.0) in propose-credential",
  "type": "object",
  "required": [
    "credential",
    "options"
  ],
  "properties": {
    "credential": {
      "type": "object",
      "required": [
        "@context",
        "type",
        "credentialSubject",
        "issuer"
      ],
      "properties": {
        "@context": {
          "description": "JSON-LD context.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "issuer": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "issuanceDate": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string"
        },
        "validFrom": {
          "type": "string"
        },
        "validUntil": {
          "type": "string"
        },
        "credentialSubject": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              },
              "minItems": 1
            }
          ]
        },
        "credentialStatus": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "proof"
        ]
      }
    },
    "options": {
      "type": "object",
      "required": [
        "proofType"
      ],
      "properties": {
        "proofType": {
          "type": "string"
        },
        "proofPurpose": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "credentialStatus": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
