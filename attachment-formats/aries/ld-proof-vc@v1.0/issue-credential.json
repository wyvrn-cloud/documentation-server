{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/aries/ld-proof-vc@v1.0/issue-credential.json",
  "title": "JSON-LD verifiable credential (Linked Data Proof) (aries/ld-proof-vc@v1.0) in issue-credential",
  "type": "object",
  "required": [
    "@context",
    "type",
    "credentialSubject",
    "issuer",
    "proof"
  ],
  "properties": {
    "@context": {
      "description": "JSON-LD context.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object"
        },
        {
          "type": "array",
          "minItems": 1
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      ]
    },
    "issuer": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "issuanceDate": {
      "type": "string"
    },
    "expirationDate": {
      "type": "string"
    },
    "validFrom": {
      "type": "string"
    },
    "validUntil": {
      "type": "string"
    },
    "credentialSubject": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        }
      ]
    },
    "credentialStatus": {
      "type": "object"
    },
    "proof": {
      "description": "One proof or a set of them.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ]
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type"
            ]
          }
        }
      ]
    }
  }
}
