{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/didcomm/w3c-di-vc-request@v0.1/request-credential.json",
  "title": "W3C VC (Data Integrity) request (didcomm/w3c-di-vc-request@v0.1) in request-credential",
  "type": "object",
  "required": [
    "data_model_version"
  ],
  "properties": {
    "data_model_version": {
      "enum": [
        "1.1",
        "2.0"
      ]
    },
    "binding_proof": {
      "type": "object",
      "properties": {
        "anoncreds_link_secret": {
          "type": "object",
          "required": [
            "entropy",
            "blinded_ms",
            "nonce"
          ],
          "properties": {
            "entropy": {
              "type": "string"
            },
            "cred_def_id": {
              "type": "string"
            },
            "blinded_ms": {
              "type": "object"
            },
            "blinded_ms_correctness_proof": {
              "type": "object"
            },
            "blinded_ms_corectness_proof": {
              "type": "object",
              "description": "The RFC's own misspelling, in its examples."
            },
            "nonce": {
              "type": "string"
            }
          }
        },
        "didcomm_signed_attachment": {
          "type": "object",
          "required": [
            "attachment_id"
          ],
          "properties": {
            "attachment_id": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
