{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/didcomm/w3c-di-vc-offer@v0.1/offer-credential.json",
  "title": "W3C VC (Data Integrity) offer (didcomm/w3c-di-vc-offer@v0.1) in offer-credential",
  "type": "object",
  "required": [
    "data_model_versions_supported",
    "credential"
  ],
  "properties": {
    "data_model_versions_supported": {
      "type": "array",
      "items": {
        "enum": [
          "1.1",
          "2.0"
        ]
      },
      "minItems": 1
    },
    "binding_required": {
      "type": "boolean"
    },
    "binding_method": {
      "type": "object",
      "properties": {
        "anoncreds_link_secret": {
          "type": "object",
          "required": [
            "nonce",
            "cred_def_id",
            "key_correctness_proof"
          ],
          "properties": {
            "nonce": {
              "type": "string"
            },
            "cred_def_id": {
              "type": "string"
            },
            "key_correctness_proof": {}
          }
        },
        "didcomm_signed_attachment": {
          "type": "object",
          "required": [
            "algs_supported",
            "did_methods_supported",
            "nonce"
          ],
          "properties": {
            "algs_supported": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "did_methods_supported": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "nonce": {
              "type": "string"
            }
          }
        }
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "@context",
        "type",
        "credentialSubject"
      ],
      "properties": {
        "@context": {
          "description": "JSON-LD context.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "type": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "issuer": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "issuanceDate": {
          "type": "string"
        },
        "expirationDate": {
          "type": "string"
        },
        "validFrom": {
          "type": "string"
        },
        "validUntil": {
          "type": "string"
        },
        "credentialSubject": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              },
              "minItems": 1
            }
          ]
        },
        "credentialStatus": {
          "type": "object"
        }
      },
      "not": {
        "required": [
          "proof"
        ]
      }
    }
  },
  "if": {
    "properties": {
      "binding_required": {
        "const": true
      }
    },
    "required": [
      "binding_required"
    ]
  },
  "then": {
    "required": [
      "binding_method"
    ]
  }
}
