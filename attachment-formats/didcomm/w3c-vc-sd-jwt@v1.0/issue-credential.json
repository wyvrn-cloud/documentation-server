{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wyvrn.app/attachment-formats/didcomm/w3c-vc-sd-jwt@v1.0/issue-credential.json",
  "title": "W3C VC (SD-JWT) (didcomm/w3c-vc-sd-jwt@v1.0) in issue-credential",
  "type": "object",
  "required": [
    "credential"
  ],
  "properties": {
    "credential": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+(~[A-Za-z0-9_.-]*)*~?$",
      "description": "The SD-JWT, in compact serialization."
    }
  }
}
